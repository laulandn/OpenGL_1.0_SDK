	make -C OpenGL\ logo -f Makefile.r68ppc
	make -C perf\ harness -f Makefile.r68ppc
	make -C raceGL -f Makefile.r68ppc
	make -C roller\ coaster -f Makefile.r68ppc
	make -C skyfly -f Makefile.r68ppc
